{
    "name": "justinholtweb/craft-microscope",
    "description": "Put your Craft site under the microscope — audits your schema, templates, PHP, database and server for performance problems, and tells you exactly how to fix each one.",
    "type": "craft-plugin",
    "version": "5.0.3",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "microscope",
        "performance",
        "audit",
        "profiling",
        "optimization",
        "opcache",
        "mysql",
        "diagnostics"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://github.com/justinholtweb/craft-microscope/blob/main/README.md",
        "source": "https://github.com/justinholtweb/craft-microscope",
        "issues": "https://github.com/justinholtweb/craft-microscope/issues"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "dompdf/dompdf": "^3.0",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "suggest": {
        "dompdf/dompdf": "Generates downloadable PDF reports and lets scheduled scans email one as an attachment. Without it, reports are still available as a print-optimised page. Note that every published dompdf release carries a security advisory, so Composer's audit policy blocks it by default — which is why Microscope treats it as optional rather than requiring it."
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\microscope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\microscope\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "craftcms/generator": true
        }
    },
    "extra": {
        "name": "Microscope",
        "handle": "microscope",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-microscope/blob/main/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-microscope/main/CHANGELOG.md",
        "class": "justinholtweb\\microscope\\Plugin"
    }
}
