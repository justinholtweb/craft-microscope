{
    "name": "justinholtweb/craft-microscope",
    "description": "Put your Craft site under the microscope — audits your schema, templates, PHP, database and server for performance problems, and tells you exactly how to fix each one.",
    "type": "craft-plugin",
    "version": "6.0.0-beta.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "microscope",
        "performance",
        "audit",
        "profiling",
        "optimization",
        "opcache",
        "mysql",
        "diagnostics",
        "laravel",
        "mcp",
        "graphql"
    ],
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://github.com/justinholtweb/craft-microscope/blob/6.0.0/README.md",
        "source": "https://github.com/justinholtweb/craft-microscope",
        "issues": "https://github.com/justinholtweb/craft-microscope/issues"
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "dompdf/dompdf": "^3.0",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "dompdf/dompdf": "Generates downloadable PDF reports and lets scheduled scans email one as an attachment. Without it, reports are still available as a print-optimised page. Note that every published dompdf release carries a security advisory, so Composer's audit policy blocks it by default — which is why Microscope treats it as optional rather than requiring it."
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Microscope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Microscope\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Microscope",
        "handle": "microscope",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-microscope/blob/6.0.0/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-microscope/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\Microscope\\Plugin"
    }
}
