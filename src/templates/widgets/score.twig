{% import "microscope/_partials/macros" as microscope %}

{% do view.registerAssetBundle("justinholtweb\\microscope\\web\\assets\\cp\\MicroscopeAsset") %}

<div class="microscope-hero microscope-widget-hero">
    {% include "microscope/_partials/gauge" with {
        score: scan.score,
        tone: scan.tone(),
        grade: scan.grade(),
        size: 110,
    } only %}

    <div class="microscope-hero-detail microscope-widget-detail">
        <p class="microscope-widget-headline">{{ result.headline() }}</p>
        <p class="light microscope-widget-date">
            {{ scan.dateCreated|timestamp('short') }}
        </p>
        <p class="microscope-widget-link">
            <a href="{{ url('microscope/scans/' ~ scan.id) }}">{{ 'View the scan'|t('microscope') }} →</a>
        </p>
    </div>
</div>

{% if widget.showCategories %}
    <div class="microscope-categories microscope-categories-compact">
        {% for category in categories %}
            {% if result.hasCategory(category) %}
                {% set score = result.categoryScore(category) %}
                <div class="microscope-category">
                    <div class="microscope-category-label">
                        {{ microscope.categoryLabel(category) }}
                    </div>
                    <div class="microscope-category-score">{{ score }}</div>
                    <div class="microscope-bar">
                        <span class="microscope-bar-{{ microscope.tone(score) }}" style="width: {{ score }}%;"></span>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}

{% if findings|length %}
    <ul class="microscope-widget-findings">
        {% for finding in findings %}
            <li>
                <span class="microscope-badge microscope-badge-{{ finding.severity }}">{{ finding.severity }}</span>
                <span>{{ finding.title }}</span>
            </li>
        {% endfor %}
    </ul>
{% endif %}
