{# The score gauge.

   Drawn as an SVG arc rather than with a chart library: it's one path, it scales, it prints, and
   it survives being rendered into a PDF by dompdf — which no canvas-based chart does.

   Params:
     score  int|null  0–100, or null for "never scanned"
     tone   string    good | fair | poor | bad | unknown
     grade  string    A–F
     size   int       pixel size, defaults to 140 #}

{% set size = size ?? 140 %}
{% set radius = 54 %}
{% set circumference = 2 * 3.14159265 * radius %}
{% set filled = score is null ? 0 : (circumference * (score / 100)) %}

<div class="microscope-gauge">
    <svg viewBox="0 0 140 140" width="{{ size }}" height="{{ size }}" role="img"
         aria-label="{{ score is null
            ? 'Not yet scanned'|t('microscope')
            : 'Performance score {score} out of 100'|t('microscope', { score: score }) }}">
        <circle class="microscope-gauge-track" cx="70" cy="70" r="{{ radius }}"></circle>
        <circle class="microscope-gauge-value microscope-tone-{{ tone }}"
                cx="70" cy="70" r="{{ radius }}"
                stroke-dasharray="{{ circumference }}"
                stroke-dashoffset="{{ circumference - filled }}"></circle>
        <text class="microscope-gauge-number" x="70" y="72" text-anchor="middle" dominant-baseline="middle">
            {{ score ?? '—' }}
        </text>
        <text class="microscope-gauge-grade" x="70" y="96" text-anchor="middle">
            {{ score is null ? 'no data'|t('microscope') : 'grade {grade}'|t('microscope', { grade: grade }) }}
        </text>
    </svg>
</div>
